rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// CREATIVE FOOTBALL — regras do Firestore
//
// Publique estas regras em:
//   Firebase Console > Firestore Database > Regras > (cole tudo) > Publicar
// ou, com o firebase-tools instalado:
//   firebase deploy --only firestore:rules
//
// AQUI mora a lista da BETA FECHADA do multiplayer (funcao betaEmails abaixo).
// Ela vale para os dois lados do jogo:
//   1. no navegador, so quem esta na lista consegue ler betaAccess/{uid} — e
//      isso que abre o lobby online em vez da tela de "beta fechada";
//   2. no servidor, o server/auth.js le esta MESMA funcao no boot e recusa
//      criar/entrar em sala de quem nao esta nela. Essa e a trava de verdade.
//
// Convidar alguem = por o e-mail aqui, dar push (o backend recarrega no deploy)
// e publicar estas regras no console. Uma lista so, dois lugares atualizados.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────── QUEM PODE JOGAR O MULTIPLAYER ─────────────────
    // Tudo em MINUSCULO, um por linha, separados por virgula.
    function betaEmails() {
      return [
        "brisasofc@gmail.com"       // adm do jogo
        // , "amigo1@gmail.com"
        // , "amigo2@gmail.com"
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Login tem que ser Google (e-mail verificado) e o e-mail tem que estar
    // na lista de cima.
    function isBetaTester() {
      return isSignedIn()
        && 'email' in request.auth.token
        && 'email_verified' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in betaEmails();
    }

    // O jogo tenta LER este documento assim que voce entra com o Google.
    // Leitura passou = libera o lobby online. Tomou permission-denied = beta
    // fechada. O documento nem precisa existir: o que vale e a permissao.
    // Ninguem escreve aqui — a lista se muda nestas regras, nao no banco.
    match /betaAccess/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid && isBetaTester();
      allow write: if false;
    }

    // Perfil do atleta: customizacao, gols, partidas e vitorias.
    // Cada jogador mexe apenas no proprio documento — e so estando logado,
    // que e o que obriga o login Google para jogar.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Qualquer outra colecao fica fechada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
