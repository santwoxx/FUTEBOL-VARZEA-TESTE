# Copie para server/.env e preencha com as credenciais do seu projeto no
# LiveKit Cloud (Settings > Keys). Este arquivo e so para desenvolvimento local:
# em producao as tres variaveis vivem no painel do Render.
#
# server/.env esta no .gitignore. NUNCA versione o API_SECRET.

LIVEKIT_URL=wss://creative-footbal-pu7l611q.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=

# Opcional: trava o backend nos dominios do frontend (em dev pode deixar vazio)
# ALLOWED_ORIGINS=https://futebol-varzea-teste.vercel.app

# ─────────────── BETA FECHADA DO MULTIPLAYER ───────────────
# Quem pode jogar online, separado por virgula. Esta e a trava DE VERDADE:
# o servidor confere o ID token do login Google contra as chaves publicas do
# Firebase antes de deixar criar/entrar em sala.
#
# Lista vazia = multiplayer aberto (comodidade em dev, igual ao ALLOWED_ORIGINS).
# Em producao, preencha no painel do Render — e mantenha igual a lista do
# firestore.rules na raiz do repositorio.
# MP_ALLOWED_EMAILS=seu-email@gmail.com,amigo@gmail.com

# Projeto do Firebase que assina os tokens (o mesmo do frontend/index.html).
# So precisa mexer se voce trocar de projeto.
# FIREBASE_PROJECT_ID=creative-footbal
